<?php if (session_status() !== PHP_SESSION_ACTIVE) {
        session_start();
        //include_once 'system/config.inc.php';
        $login = isset($_SESSION['seguranca']['login']) ? $_SESSION['seguranca']['login'] :"";
        
        if(!$login){
            $pagina = $_GET['page'] = 'login';
        }
      }

$modulo = isset($_GET['mod']) ? $_GET['mod'] : 'index';
$pagina = isset($_GET['page']) ? $_GET['page'] : 'menupg';
$acao   = isset($_GET['action']) ? $_GET['action'] : 'inicio';
$param  = isset($_GET['param']) ? $_GET['param'] : '';

# menu principal
if($pagina == "menupg") {
  include_once "/template/page/menupg.php";
#login
}elseif ($pagina == "login") {
  include_once "/template/page/login.php";
# pagina branco
}else {
  include_once $pagina.'.php';
}



